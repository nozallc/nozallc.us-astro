			</div>
		</div>
	</section>
</RootLayout>

<style>
	.legal-section {
		padding: 4rem 2rem;
		background: linear-gradient(180deg, rgba(0, 0, 0, 0.1) 0%, rgba(0, 0, 0, 0.05) 100%);
		min-height: 100vh;
	}

	.legal-container {
		max-width: 800px;
		margin: 0 auto;
	}

	h1 {
		font-size: 2.5rem;
		margin-bottom: 0.5rem;
		color: var(--text-primary);
		font-weight: 800;
		background: linear-gradient(135deg, var(--primary-neon), var(--secondary-neon));
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
		background-clip: text;
	}

	.last-updated {
		font-size: 0.9rem;
		color: var(--text-secondary);
		margin-bottom: 2rem;
		font-style: italic;
	}

	.legal-content {
		color: var(--text-primary);
		line-height: 1.8;
	}

	h2 {
		font-size: 1.5rem;
		margin: 2rem 0 1rem;
		color: var(--text-primary);
		font-weight: 700;
	}

	h3 {
		font-size: 1.1rem;
		margin: 1.5rem 0 0.75rem;
		color: var(--text-secondary);
		font-weight: 600;
	}

	p {
		margin-bottom: 1rem;
		color: var(--text-primary);
	}

	ul {
		margin-bottom: 1.5rem;
		margin-left: 1.5rem;
	}

	li {
		margin-bottom: 0.5rem;
		color: var(--text-primary);
	}

	a {
		color: var(--primary-neon);
		text-decoration: none;
		transition: opacity 0.3s ease;
	}

	a:hover {
		opacity: 0.8;
		text-decoration: underline;
	}

	.contact-info {
		background: rgba(0, 212, 255, 0.05);
		border: 1px solid rgba(0, 212, 255, 0.2);
		border-radius: 8px;
		padding: 1.5rem;
		margin: 1.5rem 0;
	}

	.contact-info p {
		margin-bottom: 0.5rem;
	}

	@media (max-width: 768px) {
		.legal-section {
			padding: 2rem 1rem;
		}

		h1 {
			font-size: 1.8rem;
		}

		h2 {
			font-size: 1.3rem;
		}
	}
</style>
